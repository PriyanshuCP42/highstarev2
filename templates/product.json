        "custom_liquid_M6yxCE": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"custom-accordion\">\n\n  <!-- Description -->\n  <div class=\"accordion-item\">\n    <button class=\"accordion-header\" onclick=\"toggleAccordion(this)\">\n       Description <span class=\"accordion-icon\">+</span>\n    </button>\n    <div class=\"accordion-body\">\n      {{ product.description }}\n    </div>\n  </div>\n\n  <!-- Specifications -->\n  <div class=\"accordion-item\">\n    <button class=\"accordion-header\" onclick=\"toggleAccordion(this)\">\n       Specifications <span class=\"accordion-icon\">+</span>\n    </button>\n    <div class=\"accordion-body\">\n      <table class=\"spec-table\">\n        <tr><td>Material</td><td>100% Cotton</td></tr>\n        <tr><td>Fit</td><td>Oversized</td></tr>\n        <tr><td>GSM</td><td>240 GSM</td></tr>\n        <tr><td>Neck Type</td><td>Round Neck</td></tr>\n        <tr><td>Sleeve</td><td>Half Sleeve</td></tr>\n        <tr><td>Origin</td><td>Made in India</td></tr>\n      </table>\n    </div>\n  </div>\n\n  <!-- Wash Care -->\n  <div class=\"accordion-item\">\n    <button class=\"accordion-header\" onclick=\"toggleAccordion(this)\">\n      Wash Care <span class=\"accordion-icon\">+</span>\n    </button>\n    <div class=\"accordion-body\">\n      <ul class=\"wash-care-list\">\n        <li>🌡️ Machine wash cold (30°C max)</li>\n        <li>🚫 Do not bleach</li>\n        <li>🔄 Tumble dry low</li>\n        <li>🧲 Do not iron on print</li>\n        <li>❌ Do not dry clean</li>\n        <li>↩️ Wash inside out to preserve print</li>\n      </ul>\n    </div>\n  </div>\n\n</div>\n\n<style>\n  .custom-accordion {\n    margin: 20px 0;\n    border-top: 1px solid #e0e0e0;\n  }\n\n  .accordion-item {\n    border-bottom: 1px solid #e0e0e0;\n  }\n\n  .accordion-header {\n    width: 100%;\n    background: none;\n    border: none;\n    padding: 14px 4px;\n    font-size: 1.95rem;\n    font-weight: 600;\n    text-align: left;\n    cursor: pointer;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    color: #111;\n    letter-spacing: 0.3px;\n  }\n\n  .accordion-header:hover {\n    color: #e63946;\n  }\n\n  .accordion-icon {\n    font-size: 1.3rem;\n    font-weight: 400;\n    transition: transform 0.3s ease;\n  }\n\n  .accordion-body {\n    display: none;\n    padding: 10px 4px 18px;\n    font-size: 0.9rem;\n    color: #444;\n    line-height: 1.7;\n  }\n\n  .accordion-body.open {\n    display: block;\n  }\n\n  .spec-table {\n    width: 100%;\n    border-collapse: collapse;\n  }\n\n  .spec-table tr td {\n    padding: 8px 10px;\n    border: 1px solid #eee;\n    font-size: 0.88rem;\n  }\n\n  .spec-table tr td:first-child {\n    font-weight: 600;\n    background: #f9f9f9;\n    width: 40%;\n  }\n\n  .wash-care-list {\n    list-style: none;\n    padding: 0;\n    margin: 0;\n  }\n\n  .wash-care-list li {\n    padding: 6px 0;\n    border-bottom: 1px dashed #eee;\n    font-size: 0.88rem;\n  }\n</style>\n\n<script>\n  function toggleAccordion(btn) {\n    const body = btn.nextElementSibling;\n    const icon = btn.querySelector('.accordion-icon');\n    const isOpen = body.classList.contains('open');\n\n    // Close all\n    document.querySelectorAll('.accordion-body').forEach(b => b.classList.remove('open'));\n    document.querySelectorAll('.accordion-icon').forEach(i => i.textContent = '+');\n\n    // Open clicked (if it was closed)\n    if (!isOpen) {\n      body.classList.add('open');\n      icon.textContent = '−';\n    }\n  }\n</script>"
          }
