            "custom_liquid": "<!-- Size Chart Button -->\n<div class=\"size-chart-wrap\">\n  <button class=\"size-chart-btn\" onclick=\"openSizeChart()\">📏 Size Chart</button>\n</div>\n\n<!-- Modal Overlay -->\n<div class=\"size-modal-overlay\" id=\"sizeChartModal\" onclick=\"closeSizeChart()\">\n  <div class=\"size-modal-box\" onclick=\"event.stopPropagation()\">\n    <button class=\"size-modal-close\" onclick=\"closeSizeChart()\">✕</button>\n    <h3 class=\"size-modal-title\">Size Chart</h3>\n    <p class=\"size-modal-note\">All measurements are in <strong>inches</strong></p>\n\n    <div class=\"size-table-wrap\">\n      <table class=\"size-table\">\n        <thead>\n          <tr>\n            <th>Size</th>\n            <th>Chest</th>\n            <th>Length</th>\n            <th>Shoulder</th>\n            <th>Sleeve</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr><td>XS</td><td>36</td><td>26</td><td>16</td><td>8</td></tr>\n          <tr><td>S</td><td>38</td><td>27</td><td>17</td><td>8.5</td></tr>\n          <tr><td>M</td><td>40</td><td>28</td><td>18</td><td>9</td></tr>\n          <tr><td>L</td><td>42</td><td>29</td><td>19</td><td>9.5</td></tr>\n          <tr><td>XL</td><td>44</td><td>30</td><td>20</td><td>10</td></tr>\n          <tr><td>XXL</td><td>46</td><td>31</td><td>21</td><td>10.5</td></tr>\n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"size-how-to\">\n      <h4>How to Measure</h4>\n      <ul>\n        <li><strong>Chest:</strong> Measure around the fullest part of your chest</li>\n        <li><strong>Length:</strong> Measure from shoulder top to hem</li>\n        <li><strong>Shoulder:</strong> Measure from shoulder seam to seam</li>\n        <li><strong>Sleeve:</strong> Measure from shoulder seam to cuff</li>\n      </ul>\n    </div>\n  </div>\n</div>\n\n<style>\n  .size-chart-wrap {\n    margin: 8px 0;\n  }\n\n  .size-chart-btn {\n    background: none;\n    border: 1.5px solid #111;\n    padding: 8px 18px;\n    font-size: 1.rem;\n    font-weight: 600;\n    cursor: pointer;\n    border-radius: 4px;\n    letter-spacing: 0.5px;\n    transition: all 0.2s ease;\n  }\n\n  .size-chart-btn:hover {\n    background: #111;\n    color: #fff;\n  }\n\n  .size-modal-overlay {\n    display: none;\n    position: fixed;\n    inset: 0;\n    background: rgba(0,0,0,0.55);\n    z-index: 9999;\n    justify-content: center;\n    align-items: center;\n  }\n\n  .size-modal-overlay.active {\n    display: flex;\n  }\n\n  .size-modal-box {\n    background: #fff;\n    border-radius: 10px;\n    padding: 28px 24px;\n    width: 90%;\n    max-width: 520px;\n    max-height: 85vh;\n    overflow-y: auto;\n    position: relative;\n  }\n\n  .size-modal-close {\n    position: absolute;\n    top: 14px;\n    right: 16px;\n    background: none;\n    border: none;\n    font-size: 1.2rem;\n    cursor: pointer;\n    color: #555;\n  }\n\n  .size-modal-title {\n    font-size: 1.2rem;\n    font-weight: 700;\n    margin-bottom: 4px;\n  }\n\n  .size-modal-note {\n    font-size: 0.8rem;\n    color: #888;\n    margin-bottom: 16px;\n  }\n\n  .size-table-wrap {\n    overflow-x: auto;\n  }\n\n  .size-table {\n    width: 100%;\n    border-collapse: collapse;\n    font-size: 0.88rem;\n  }\n\n  .size-table th {\n    background: #111;\n    color: #fff;\n    padding: 10px 12px;\n    text-align: center;\n  }\n\n  .size-table td {\n    padding: 9px 12px;\n    text-align: center;\n    border-bottom: 1px solid #eee;\n  }\n\n  .size-table tbody tr:nth-child(even) {\n    background: #f9f9f9;\n  }\n\n  .size-table tbody tr:hover {\n    background: #f0f0f0;\n  }\n\n  .size-how-to {\n    margin-top: 20px;\n    padding-top: 16px;\n    border-top: 1px solid #eee;\n  }\n\n  .size-how-to h4 {\n    font-size: 0.95rem;\n    font-weight: 700;\n    margin-bottom: 10px;\n  }\n\n  .size-how-to ul {\n    list-style: none;\n    padding: 0;\n    margin: 0;\n  }\n\n  .size-how-to ul li {\n    font-size: 0.85rem;\n    color: #555;\n    padding: 5px 0;\n    border-bottom: 1px dashed #eee;\n  }\n</style>\n\n<script>\n  function openSizeChart() {\n    const modal = document.getElementById('sizeChartModal');\n    if (modal.parentNode !== document.body) {\n      document.body.appendChild(modal);\n    }\n    modal.classList.add('active');\n    document.body.style.overflow = 'hidden';\n  }\n\n  function closeSizeChart() {\n    document.getElementById('sizeChartModal').classList.remove('active');\n    document.body.style.overflow = '';\n  }\n</script>"
