            "custom_liquid": "{% assign current_variant = product.selected_or_first_available_variant %}\n<div class=\"urgency-banner\" id=\"urgency-banner-{{ section.id }}\">\n  <span class=\"urgency-text\">\n    {% if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 10 %}\n      Hurry! Only <strong>{{ current_variant.inventory_quantity }}</strong> left in stock.\n    {% else %}\n      <span class=\"pulse-dot\"></span> <strong id=\"viewer-count\">12</strong> people are viewing this right now.\n    {% endif %}\n  </span>\n</div>\n\n<style>\n  .urgency-banner {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    background-color: #fff4f4;\n    border: 1px solid #ffcccc;\n    padding: 10px 14px;\n    border-radius: 6px;\n    margin: 12px 0 16px;\n    color: #d8000c;\n    font-size: 0.95rem;\n  }\n  .urgency-text {\n    flex-grow: 1;\n  }\n  .pulse-dot {\n    display: inline-block;\n    width: 8px;\n    height: 8px;\n    background-color: #d8000c;\n    border-radius: 50%;\n    margin-right: 4px;\n    animation: pulse 1.5s infinite;\n  }\n  @keyframes pulse {\n    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(216, 0, 12, 0.7); }\n    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(216, 0, 12, 0); }\n    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(216, 0, 12, 0); }\n  }\n</style>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function() {\n    const viewerCountEl = document.getElementById('viewer-count');\n    if (viewerCountEl) {\n      let count = Math.floor(Math.random() * (15 - 5 + 1)) + 5;\n      viewerCountEl.textContent = count;\n      setInterval(() => {\n        const change = Math.random() > 0.5 ? 1 : -1;\n        count = count + change;\n        if (count < 3) count = 3;\n        if (count > 25) count = 25;\n        viewerCountEl.textContent = count;\n      }, 5000 + Math.random() * 5000);\n    }\n  });\n</script>"
