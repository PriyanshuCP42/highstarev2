        "custom_liquid_reviews_badge": {
          "type": "custom_liquid",
          "disabled": true,
          "settings": {
            "custom_liquid": "{%- liquid\n  assign p_id = product.id | default: 12345678\n  assign mod_10 = p_id | modulo: 10\n  assign mod_290 = p_id | modulo: 290\n  if mod_10 <= 3\n    assign p_rating = '4.6'\n  elsif mod_10 <= 7\n    assign p_rating = '4.7'\n  else\n    assign p_rating = '4.8'\n  endif\n  assign p_reviews = 175 | plus: mod_290 | plus: mod_10\n-%}\n<div class=\"trust-review-badge\" onclick=\"scrollToReviews()\">\n  <div class=\"stars-group\">\n    <span class=\"star-icon\">★</span>\n    <span class=\"star-icon\">★</span>\n    <span class=\"star-icon\">★</span>\n    <span class=\"star-icon\">★</span>\n    <span class=\"star-icon\">★</span>\n  </div>\n  <span class=\"rating-score\">{{ p_rating }}</span>\n  <span class=\"rating-count\">({{ p_reviews }} reviews)</span>\n  <span class=\"verified-tag\">✓ Verified</span>\n</div>\n\n<style>\n  .product__info-container > .trust-review-badge,\n  .trust-review-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 9px;\n    margin-top: 4px !important;\n    margin-bottom: 14px !important;\n    cursor: pointer;\n    font-family: inherit;\n    flex-wrap: wrap;\n    transition: transform 0.15s ease;\n  }\n  .trust-review-badge:hover {\n    transform: translateY(-1px);\n  }\n  .trust-review-badge:hover .rating-count {\n    text-decoration: underline;\n    color: #111;\n  }\n  .stars-group {\n    display: inline-flex;\n    color: #ffb800;\n    font-size: 1.35rem;\n    letter-spacing: 2px;\n    line-height: 1;\n  }\n  .rating-score {\n    font-weight: 700;\n    font-size: 1.15rem;\n    color: #111;\n  }\n  .rating-count {\n    font-size: 1.05rem;\n    color: #444;\n    font-weight: 500;\n  }\n  .verified-tag {\n    background: #eef7ee;\n    color: #2e7d32;\n    font-size: 0.85rem;\n    font-weight: 600;\n    padding: 4px 10px;\n    border-radius: 20px;\n    letter-spacing: 0.3px;\n    display: inline-flex;\n    align-items: center;\n  }\n  .product__info-container .jdgm-prev-badge,\n  .product__info-container .jdgm-preview-badge {\n    display: none !important;\n  }\n</style>\n\n<script>\n  function scrollToReviews() {\n    const target = document.querySelector('.jdgm-rev-widg') || document.querySelector('[id*=\"judge_me\"]') || document.querySelector('#judgeme_product_reviews') || document.querySelector('.custom-accordion');\n    if (target) {\n      target.scrollIntoView({ behavior: 'smooth', block: 'start' });\n    }\n  }\n</script>"
          }
        },
