{
  "name": "Highstare hero slider",
  "settings": [
    {"type":"header","content":"Slides"},
    {"type":"image_picker","id":"desktop_image_1","label":"Slide 1 desktop image"},{"type":"image_picker","id":"mobile_image_1","label":"Slide 1 mobile image"},{"type":"url","id":"slide_link_1","label":"Slide 1 link"},{"type":"text","id":"alt_text_1","label":"Slide 1 alt text"},
    {"type":"image_picker","id":"desktop_image_2","label":"Slide 2 desktop image"},{"type":"image_picker","id":"mobile_image_2","label":"Slide 2 mobile image"},{"type":"url","id":"slide_link_2","label":"Slide 2 link"},{"type":"text","id":"alt_text_2","label":"Slide 2 alt text"},
    {"type":"image_picker","id":"desktop_image_3","label":"Slide 3 desktop image"},{"type":"image_picker","id":"mobile_image_3","label":"Slide 3 mobile image"},{"type":"url","id":"slide_link_3","label":"Slide 3 link"},{"type":"text","id":"alt_text_3","label":"Slide 3 alt text"},
    {"type":"image_picker","id":"desktop_image_4","label":"Slide 4 desktop image"},{"type":"image_picker","id":"mobile_image_4","label":"Slide 4 mobile image"},{"type":"url","id":"slide_link_4","label":"Slide 4 link"},{"type":"text","id":"alt_text_4","label":"Slide 4 alt text"},
    {"type":"image_picker","id":"desktop_image_5","label":"Slide 5 desktop image"},{"type":"image_picker","id":"mobile_image_5","label":"Slide 5 mobile image"},{"type":"url","id":"slide_link_5","label":"Slide 5 link"},{"type":"text","id":"alt_text_5","label":"Slide 5 alt text"},
    {"type":"image_picker","id":"desktop_image_6","label":"Slide 6 desktop image"},{"type":"image_picker","id":"mobile_image_6","label":"Slide 6 mobile image"},{"type":"url","id":"slide_link_6","label":"Slide 6 link"},{"type":"text","id":"alt_text_6","label":"Slide 6 alt text"},
    {"type":"header","content":"Slider controls"},{"type":"checkbox","id":"autoplay","label":"Autoplay","default":false},{"type":"range","id":"autoplay_speed","label":"Autoplay speed","min":3,"max":10,"step":1,"unit":"s","default":5},{"type":"checkbox","id":"show_dots","label":"Show dots","default":true},{"type":"checkbox","id":"show_arrows","label":"Show arrows","default":true},{"type":"checkbox","id":"show_controls","label":"Show controls","default":true},
    {"type":"header","content":"Layout"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":60,"step":5,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":60,"step":5,"unit":"px","default":0},{"type":"select","id":"width_mode","label":"Content width","options":[{"value":"full","label":"Full width"},{"value":"page","label":"Page width"}],"default":"full"},{"type":"color","id":"background_color","label":"Background","default":"#FFFFFF"},{"type":"range","id":"corner_radius","label":"Rounded corners","min":0,"max":40,"step":2,"unit":"px","default":0}
  ],
  "presets": [{"name":"Highstare hero slider"}],
  "tag": null,
  "class": "highstare-hero-slider"
}
{% endschema %}