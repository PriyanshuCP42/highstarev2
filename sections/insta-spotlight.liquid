{{ 'component-card.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | default: 52 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 52 }}px;
  }

  .hs-blood-gallery-wrapper {
    width: 100%;
    overflow: hidden;
    position: relative;
    background: #ffffff;
    border-top: 1px solid #f0f0f0;
    border-bottom: 1px solid #f0f0f0;
  }

  .hs-blood-header {
    max-width: 950px;
    margin: 0 auto 36px;
    padding: 0 1.5rem;
    text-align: center;
  }

  /* Streetwear Blood Red Top Tag */
  .hs-blood-tag-wrap {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
    padding: 6px 18px 6px 14px;
    background: linear-gradient(90deg, rgba(193, 18, 31, 0.08) 0%, rgba(193, 18, 31, 0.02) 100%);
    border: 1px solid rgba(193, 18, 31, 0.15);
    border-radius: 100px;
    box-shadow: 0 4px 12px rgba(193, 18, 31, 0.06);
    backdrop-filter: blur(4px);
  }

  .hs-blood-pulse {
    width: 6px;
    height: 6px;
    background: #c1121f;
    border-radius: 50%;
    box-shadow: 0 0 8px #c1121f;
    animation: hsBloodPulse 1.6s infinite;
  }

  @keyframes hsBloodPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.5); opacity: 0.5; }
  }

  .hs-blood-tag-text {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 2.5px;
    color: #c1121f;
    text-transform: uppercase;
  }

  /* Monumental Two-Tone Headline */
  .hs-blood-title {
    font-size: clamp(2rem, 5vw, 3.6rem);
    font-weight: 900;
    color: #000000;
    margin: 0 0 16px 0;
    letter-spacing: -1.5px;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .hs-blood-highlight {
    color: #c1121f;
    display: inline;
    position: relative;
  }

  /* Goosebumps Manifesto Subtext */
  .hs-blood-manifesto {
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    color: #374151;
    margin: 0 auto 24px;
    line-height: 1.55;
    max-width: 720px;
    font-weight: 500;
    letter-spacing: -0.2px;
  }

  /* Streetwear Blood Red CTA Button */
  .hs-blood-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #000000;
    color: #ffffff;
    text-decoration: none;
    padding: 12px 26px;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    border: 1px solid #000000;
    transition: all 0.3s ease;
    box-shadow: 0 4px 14px rgba(193, 18, 31, 0.15);
  }

  .hs-blood-cta:hover {
    background: #c1121f;
    border-color: #c1121f;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(193, 18, 31, 0.35);
  }

  .hs-blood-cta svg {
    width: 15px;
    height: 15px;
    transition: transform 0.2s ease;
  }

  .hs-blood-cta:hover svg {
    transform: translate(2px, -2px);
  }

  /* Marquee Track */
  .hs-blood-marquee-box {
    width: 100%;
    overflow: hidden;
    user-select: none;
    position: relative;
    padding: 6px 0 16px;
  }

  .hs-blood-marquee-box:hover .hs-blood-marquee-track {
    animation-play-state: paused;
  }

  .hs-blood-marquee-track {
    display: flex;
    gap: 3px;
    width: max-content;
    animation: hsBloodGlide 22s linear infinite;
    will-change: transform;
    transform: translate3d(0, 0, 0);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  @keyframes hsBloodGlide {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* Sharp Rectangular Frames */
  .hs-blood-card {
    position: relative;
    width: clamp(380px, 45vw, 600px);
    aspect-ratio: 819 / 1024;
    flex-shrink: 0;
    border-radius: 0px !important;
    overflow: hidden;
    background: #0a0a0a;
    text-decoration: none;
    display: block;
    border: none;
  }

  .hs-blood-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    border-radius: 0px !important;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  }

  .hs-blood-card:hover .hs-blood-img {
    transform: scale(1.03);
    opacity: 0.94;
  }

  @media screen and (max-width: 749px) {
    .hs-blood-card {
      width: 82vw;
      max-width: 360px;
    }
    .hs-blood-marquee-track {
      gap: 2px;
      animation-duration: 14s;
    }
    .hs-blood-title {
      font-size: 1.85rem;
    }
  }
{%- endstyle -%}

{%- liquid
  assign is_doomsday = false
  assign is_fifa = false
  assign is_anime = false

  # 1. Check active collection context
  if collection and collection.handle != 'all' and collection.handle != 'frontpage'
    assign col_h = collection.handle | downcase
    assign col_t = collection.title | downcase
    if col_h contains 'doomsday' or col_t contains 'doomsday' or col_h contains 'doom' or col_t contains 'doom'
      assign is_doomsday = true
    elsif col_h contains 'fifa' or col_t contains 'fifa'
      assign is_fifa = true
    elsif col_h contains 'anime' or col_t contains 'anime'
      assign is_anime = true
    endif
  endif

  # 2. Check product collections
  if product
    if is_fifa == false
      for col in product.collections
        assign c_h = col.handle | downcase
        assign c_t = col.title | downcase
        if c_h contains 'fifa' or c_t contains 'fifa'
          assign is_fifa = true
          break
        endif
      endfor
    endif

    # 3. Check product tags
    if is_fifa == false
      for tag in product.tags
        assign t_l = tag | downcase
        if t_l contains 'fifa'
          assign is_fifa = true
          break
        endif
      endfor
    endif

    # 4. Check product handle and title
    if is_fifa == false
      assign p_handle = product.handle | downcase
      assign p_title = product.title | downcase
      if p_handle contains 'fifa' or p_title contains 'fifa' or p_handle contains 'messi' or p_handle contains 'ronaldo' or p_handle contains 'salah' or p_handle contains 'yamal' or p_handle contains 'neymar' or p_handle contains 'mbappe' or p_handle contains 'bellingham' or p_handle contains 'football' or p_title contains 'messi' or p_title contains 'ronaldo' or p_title contains 'salah' or p_title contains 'yamal' or p_title contains 'football'
        assign is_fifa = true
      endif
    endif

    # 5. Check Doomsday
    if is_doomsday == false and is_fifa == false
      for col in product.collections
        assign c_h = col.handle | downcase
        assign c_t = col.title | downcase
        if c_h contains 'doomsday' or c_t contains 'doomsday' or c_h contains 'doom' or c_t contains 'doom'
          assign is_doomsday = true
          break
        endif
      endfor
    endif

    if is_doomsday == false and is_fifa == false
      for tag in product.tags
        assign tag_lower = tag | downcase
        if tag_lower contains 'doomsday' or tag_lower contains 'doom'
          assign is_doomsday = true
          break
        endif
      endfor
    endif

    if is_doomsday == false and is_fifa == false
      assign prod_handle = product.handle | downcase
      assign prod_title = product.title | downcase
      if prod_handle contains 'doomsday' or prod_title contains 'doomsday' or prod_handle contains 'doom' or prod_title contains 'doom'
        assign is_doomsday = true
      endif
    endif

    # 6. Check Anime
    if is_anime == false and is_fifa == false and is_doomsday == false
      for col in product.collections
        assign c_h = col.handle | downcase
        assign c_t = col.title | downcase
        if c_h contains 'anime' or c_t contains 'anime'
          assign is_anime = true
          break
        endif
      endfor
    endif

    if is_anime == false and is_fifa == false and is_doomsday == false
      for tag in product.tags
        assign tag_l = tag | downcase
        if tag_l contains 'anime'
          assign is_anime = true
          break
        endif
      endfor
    endif

    if is_anime == false and is_fifa == false and is_doomsday == false
      assign prod_h = product.handle | downcase
      assign prod_t = product.title | downcase
      if prod_h contains 'anime' or prod_t contains 'anime' or prod_h contains 'itachi' or prod_t contains 'itachi' or prod_h contains 'eren' or prod_t contains 'eren' or prod_h contains 'naruto' or prod_t contains 'naruto' or prod_h contains 'gojo' or prod_t contains 'gojo' or prod_h contains 'sukuna' or prod_t contains 'sukuna' or prod_h contains 'goku' or prod_t contains 'goku' or prod_h contains 'dragon-ball' or prod_t contains 'dragon ball' or prod_h contains 'jujutsu' or prod_t contains 'jujutsu' or prod_h contains 'death-note' or prod_t contains 'death note' or prod_h contains 'titan' or prod_t contains 'titan' or prod_h contains 'zoro' or prod_t contains 'zoro' or prod_h contains 'luffy' or prod_t contains 'luffy' or prod_h contains 'one-piece' or prod_t contains 'one piece'
        assign is_anime = true
      endif
    endif
  endif
-%}

