<style>
  .y2k-marquee-container {
    width: 100%;
    overflow: hidden;
    background: #000;
    color: #fff;
    padding: 12px 0;
    display: flex;
    align-items: center;
    border-bottom: 1px solid #222;
  }
  .y2k-marquee {
    display: flex;
    white-space: nowrap;
    animation: y2k-scroll 40s linear infinite;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-size: 1.3rem;
  }
  .y2k-marquee-item {
    display: flex;
    align-items: center;
    padding: 0;
  }
  .y2k-symbol {
    font-size: 1.4rem;
    margin: 0 3rem;
    animation: color-pulse 3s infinite;
  }
  @keyframes y2k-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @keyframes color-pulse {
    0% { color: #ff00ff; } /* Neon Pink */
    33% { color: #00ffff; } /* Cyan */
    66% { color: #39ff14; } /* Neon Green */
    100% { color: #ff00ff; }
  }
  .y2k-highlight {
    color: #39ff14;
    text-shadow: 0 0 8px rgba(57, 255, 20, 0.6);
  }
  .interactive-badge {
    display: inline-block;
    background: linear-gradient(45deg, #ff00ff, #00ffff);
    color: #000;
    padding: 2px 12px;
    border-radius: 20px;
    font-weight: 900;
    text-transform: uppercase;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
    box-shadow: 0 0 10px rgba(0, 255, 255, 0.5);
    margin: 0 5px;
  }
  .interactive-badge:hover {
    transform: scale(1.05);
    box-shadow: 0 0 20px rgba(255, 0, 255, 0.8);
  }
  .trust-badge {
    display: inline-flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 2px 12px;
    border-radius: 4px;
    gap: 6px;
    transition: background 0.3s ease, border-color 0.3s ease;
  }
  .trust-badge:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: #39ff14;
  }
</style>

<div class="y2k-marquee-container">
  <div class="y2k-marquee">
    {%- for i in (1..10) -%}
      <div class="y2k-marquee-item">
        HASSLE-FREE RETURNS 🔄 <span class="y2k-symbol">✦</span> 🚨 NO RESTOCKS 🚨 <span class="y2k-symbol">✚</span> <span class="y2k-highlight">💳 10% OFF ON ALL PREPAID ORDERS 💸</span> <span class="y2k-symbol">✦</span> 🚚 FREE SHIPPING <span class="y2k-symbol">✚</span> <span class="trust-badge">✅ 10000+ HAPPY CUSTOMERS ⭐</span> <span class="y2k-symbol">✦</span> <span class="interactive-badge">SECURE YOUR DROP 🔒</span> <span class="y2k-symbol">✚</span>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "class": "announcement-bar-section",
  "settings": [],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name"
    }
  ]
}
{% endschema %}
