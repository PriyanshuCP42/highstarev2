<style>
  .announcement-marquee {
    width: 100%;
    overflow: hidden;
    background: #000;
    color: #fff;
    padding: 10px 0;
    display: flex;
    align-items: center;
    position: relative;
  }

  .announcement-track {
    display: flex;
    white-space: nowrap;
    animation: announcement-scroll 50s linear infinite;
    will-change: transform;
  }

  .announcement-track:hover {
    animation-play-state: paused;
  }

  .announcement-item {
    display: flex;
    align-items: center;
    gap: 0;
    flex-shrink: 0;
  }

  .announcement-text {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    transition: color 0.3s ease;
  }

  .announcement-text:hover {
    color: #fff;
  }

  .announcement-separator {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    margin: 0 2.5rem;
    flex-shrink: 0;
  }

  @keyframes announcement-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* Subtle edge fade for premium feel */
  .announcement-marquee::before,
  .announcement-marquee::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 40px;
    z-index: 2;
    pointer-events: none;
  }
  .announcement-marquee::before {
    left: 0;
    background: linear-gradient(to right, #000, transparent);
  }
  .announcement-marquee::after {
    right: 0;
    background: linear-gradient(to left, #000, transparent);
  }

  @media (max-width: 749px) {
    .announcement-text {
      font-size: 10px;
      letter-spacing: 0.1em;
    }
    .announcement-separator {
      margin: 0 1.5rem;
    }
  }
</style>

<div class="announcement-marquee">
  <div class="announcement-track">
    {%- for i in (1..8) -%}
      <div class="announcement-item">
        <span class="announcement-text">Free Shipping on All Orders</span>
        <span class="announcement-separator"></span>
        <span class="announcement-text">10% Off on Prepaid Orders</span>
        <span class="announcement-separator"></span>
        <span class="announcement-text">Limited Edition — No Restocks</span>
        <span class="announcement-separator"></span>

        <span class="announcement-text">Secure Checkout</span>
        <span class="announcement-separator"></span>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "class": "announcement-bar-section",
  "settings": [],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name"
    }
  ]
}
{% endschema %}
