<div id="judgeme_product_reviews" class="hs-fifa-reviews-wrapper jdgm-widget jdgm-review-widget" data-product-title="{{ product.title | escape }}" data-id="{{ product.id }}">
  <div class="hs-fifa-reviews-inner page-width">
    <!-- Header: Title on Left, Write a Review Button on Right (No arrow toggles) -->
    <div class="hs-slider-header">
      <div class="hs-slider-title-group">
        <h2 class="hs-rev-title">WHAT CUSTOMERS SAY</h2>
      </div>

      <div class="hs-slider-actions">
        <button type="button" class="hs-write-rev-cta" onclick="openReviewModal()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
          </svg>
          Write a review
        </button>
      </div>
    </div>

    <!-- Slideshow Carousel Viewport (Slide by swiping right/left) -->
    <div class="hs-slider-viewport">
      <div class="hs-slider-track" id="hs-reviews-track">
        <!-- Slide 1: Messi Layered Tee Gym Review (FIRST IMAGE) -->
        <div class="hs-slide-card" onclick="openReviewLightbox('{{ 'Messi-Layered-Tee-Gym-Review.png' | asset_url }}')">
          <div class="hs-slide-img-wrap">
            <img
              src="{{ 'Messi-Layered-Tee-Gym-Review.png' | asset_url }}"
              alt="Customer Review - Messi 10 Layered Tee Gym Fit"
              class="hs-slide-img"
              loading="lazy"
              decoding="async"
              width="906"
              height="1736"
            >
            <div class="hs-slide-overlay">
              <span class="hs-slide-zoom-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  <line x1="11" y1="8" x2="11" y2="14"></line>
                  <line x1="8" y1="11" x2="14" y2="11"></line>
                </svg>
                VIEW
              </span>
            </div>
          </div>
        </div>

        <!-- Slide 2: Espana 19 Matchday Review -->
        <div class="hs-slide-card" onclick="openReviewLightbox('{{ 'Espana-19-Matchday-Review.png' | asset_url }}')">
